[user]
	name = Elias H Aronsson
	email = elias@andonlabs.com
[safe]
	directory = {{ .chezmoi.homeDir }}/Documents/code/vending-agent-legacy
[pull]
	rebase = true
[core]
	autocrlf = input
    pager = delta
    # Global hooks dir, so the gitleaks pre-commit scan applies to every repo without
    # per-repo installation. NOTE: this SHADOWS .git/hooks everywhere -- the hook script
    # chains to the repo's own pre-commit afterwards so the pre-commit framework used by
    # the andon-os repos keeps working.
    hooksPath = ~/.config/git/hooks
[interactive]
    diffFilter = delta --color-only
[delta]
    navigate = true  # use n and N to move between diff sections
    dark = true      # or light = true, or o
[alias]
	co = checkout
	br = branch
	ci = commit
	cia = commit --amend
	cin = commit --no-verify
	cian = commit --amend --no-verify
	st = status
	wc = log --raw --no-merges
	df = diff
	d = pull
	u = push
	un = push --no-verify
	uf = push --force-with-lease
	cp = cherry-pick
	sw = show
	rs = restore --staged
	re = restore
	rb = rebase
	rbc = rebase --continue
	rba = rebase --abort
	prb = pull origin main --rebase --autostash
	a = add
	ad = add -i
	ap = add -p
	au = add -u
	ac = !git add -u && git commit
	acp = !git add -u && git commit && git push
	sh = stash
	shp = stash push
	aucp = !git add -u && git commit && git push
	res = restore --staged
	auc = !git add -u && git commit
	cip = !git commit && git push
	rbi = rebase -i
	cob = checkout -b
[push]
	autoSetupRemote = true
	autoSetupRemote = true
	autoSetupRemote = true
	autoSetupRemote = true
	autoSetupRemote = true
[credential "https://github.com"]
	helper = 
	helper = !/usr/bin/gh auth git-credential
[credential "https://gist.github.com"]
	helper = 
	helper = !/usr/bin/gh auth git-credential
[merge]
	conflictstyle = zdiff3
[rerere]
	enabled = true
	autoupdate = true
[filter "lfs"]
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
	required = true

[core]
	# untrackedCache remembers which untracked dirs changed, so `git status` skips
	# rescanning them. Needs git >= 2.37 (have 2.55).
	#
	# core.fsmonitor is deliberately NOT enabled. It was tried 2026-09-23 and removed
	# 2026-09-28: it made the FIRST git command in each repo pay for starting
	# `git fsmonitor--daemon`, and bought nothing back. Measured (idle machine):
	#            andon-os (10k tracked / 117k worktree)  pydantic-ai   chezmoi
	#   fsmonitor on   cold 316ms / warm 12ms            44ms / 8ms    18ms / 7ms
	#   fsmonitor off  cold  18ms / warm 13ms            10ms / 7ms     7ms / 6ms
	# Slower cold, identical warm. Under load the cold case reached ~12s, which is what
	# made starship's prompt print "command timed out" whenever I cd'd into a fresh repo.
	untrackedCache = true
[feature]
	manyFiles = true
