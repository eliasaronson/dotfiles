# mako notification daemon (Wayland; replaces dunst under sway).
# The key line is default-timeout — without it mako never auto-dismisses.
default-timeout=5000
# Always apply the timeouts below, even when an app requests "never expire"
# (Claude Code and notify-send do -> they'd otherwise stay up forever, while
# apps that don't ask, like Signal, already auto-dismissed).
ignore-timeout=1

# Badwolf-ish theme to match wezterm.
font=JetBrainsMono Nerd Font 11
background-color=#1c1b1a
text-color=#f8f6f2
border-color=#0a9dff
border-size=2
padding=8
margin=10
max-visible=5
anchor=top-right

# Urgent notifications stay until dismissed.
[urgency=critical]
default-timeout=0
border-color=#ff2c4b
