# Sway-only config (Wayland-specific)
# Included by ~/.config/sway/config

# Keyboard layout: the custom us_swe layout (US + åäö on AltGr), same as X11.
# libxkbcommon reads it from the NixOS xkb.extraLayouts patch; no variant needed.
# (The old `se` + `US_swe` variant doesn't exist -> "failed to compile keymap".)
input type:keyboard {
    xkb_layout us_swe
}
# Toggle plain US <-> us_swe (mirrors the i3 mod+u / mod+Shift+u bindings)
bindsym $mod+Shift+u input type:keyboard xkb_layout us
bindsym $mod+u input type:keyboard xkb_layout us_swe

# Cursor: explicit theme + size so it's consistent across the scale-2 laptop and
# scale-1 ultrawide (sway scales it per-output automatically).
seat seat0 xcursor_theme Adwaita 24

# Application launcher (Wayland)
bindsym $mod+d exec fuzzel

# Clipboard manager (Wayland — requires cliphist + wl-copy)
bindsym $mod+z exec cliphist list | fuzzel -d | cliphist decode | wl-copy

# Screenshots (mirrors the i3 flow, via ~/.local/bin/wl-screenshot-*):
#   Print       region -> clipboard only
#   Shift+Print region -> file (+ clipboard + notify)
#   $mod+Print  focused window -> clipboard
bindsym Print exec ~/.local/bin/wl-screenshot-clip
bindsym Shift+Print exec ~/.local/bin/wl-screenshot-save
bindsym $mod+Print exec ~/.local/bin/wl-screenshot-window
# flameshot: FREEZES the screen, then region-select + annotate + copy/save (the thing
# you missed). Region selection happens on the frozen image. Uses the screenshot portal.
bindsym Ctrl+Print exec flameshot gui
# swappy: region select (live) -> annotate; Ctrl+C copies, Ctrl+S saves.
bindsym $mod+Ctrl+s exec ~/.local/bin/wl-screenshot-annotate

# Reload sway config (Sway doesn't have "restart", only "reload")
bindsym $mod+Shift+r reload

# Exit sway
bindsym $mod+Shift+e exec swaynag -t warning -m 'You pressed the exit shortcut. Do you really want to exit sway? This will end your Wayland session.' -b 'Yes, exit sway' 'swaymsg exit'

# Network manager tray (needs --indicator for Wayland tray protocol)
exec nm-applet --indicator

# Notification daemon
exec mako

# Bluetooth headphone media buttons (AVRCP) -> MPRIS players (i3 does this in i3-only).
exec mpris-proxy

# Clipboard history: this watcher populates what $mod+z (cliphist list) shows.
exec wl-paste --watch cliphist store

# Night light (Wayland). redshift is X11-only and only tints XWayland here, so use
# gammastep against the real wlr outputs. Same geoclue2 location + 6500K/3700K as i3.
exec gammastep -l geoclue2 -t 6500:3700

# Float browser notification popups that bypass mako
for_window [app_id="chrome-.*"] floating enable
for_window [title=".*— Indicator.*"] floating enable

# Output scaling + positioning is handled by kanshi (~/.config/kanshi/config), which
# applies a profile automatically on dock/undock. INTEGER scales only, on purpose: a
# fractional scale blurs apps without wp-fractional-scale-v1 (Chrome etc.); integer is
# crisp for every app, and laptop 236/2=118 vs ultrawide 110/1=110 land ~same size.
# Want the ultrawide bigger? Use per-app font size, not a fractional scale.
exec kanshi
output * bg ~/Pictures/DSC_0244.jpg fill

# Workspace -> output: docked, 1-9 go to the ultrawide and 0 to the laptop; each falls
# back to eDP-1 when laptop-only. Mirrors monitor-setup's home layout.
workspace 1 output HDMI-A-1 eDP-1
workspace 2 output HDMI-A-1 eDP-1
workspace 3 output HDMI-A-1 eDP-1
workspace 4 output HDMI-A-1 eDP-1
workspace 5 output HDMI-A-1 eDP-1
workspace 6 output HDMI-A-1 eDP-1
workspace 7 output HDMI-A-1 eDP-1
workspace 8 output HDMI-A-1 eDP-1
workspace 9 output HDMI-A-1 eDP-1
workspace 0 output eDP-1

# Hidden Julia scratchpad calculator: wezterm --class sets the Wayland app_id (not an
# X11 class), so sway needs [app_id=...] here where i3 uses [class=...] in shared.
for_window [app_id="juliacalc"] move scratchpad, resize set 1200 600

# Lock screen: swaylock on demand + swayidle for auto-lock/DPMS (replaces xss-lock).
bindsym $mod+Shift+x exec swaylock -f -c 1c1b1a
exec swayidle -w \
    timeout 300 'swaylock -f -c 1c1b1a' \
    timeout 600 'swaymsg "output * power off"' \
    resume 'swaymsg "output * power on"' \
    before-sleep 'swaylock -f -c 1c1b1a'

# Workspace output assignments come with the kanshi dock profiles (step 2); until
# then sway auto-places workspaces on whatever outputs are connected.
