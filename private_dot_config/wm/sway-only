# Sway-only config (Wayland-specific)
# Included by ~/.config/sway/config

# Keyboard layout: the custom us_swe layout (US + åäö on AltGr), same as X11.
# libxkbcommon reads it from the NixOS xkb.extraLayouts patch; no variant needed.
# (The old `se` + `US_swe` variant doesn't exist -> "failed to compile keymap".)
input type:keyboard {
    xkb_layout us_swe
}
# Toggle plain US <-> us_swe (mirrors the i3 mod+u / mod+Shift+u bindings)
bindsym $mod+Shift+u input type:keyboard xkb_layout us
bindsym $mod+u input type:keyboard xkb_layout us_swe

# Application launcher (Wayland)
bindsym $mod+d exec fuzzel

# Clipboard manager (Wayland — requires cliphist + wl-copy)
bindsym $mod+z exec cliphist list | fuzzel -d | cliphist decode | wl-copy

# Screenshots (Wayland — requires grim, slurp, wl-copy)
# Full screen capture
bindsym Print exec grim - | wl-copy && grim ~/Pictures/screenshots/screenshot_$(date +%Y%m%d_%H%M%S).png
# Area selection
bindsym Shift+Print exec grim -g "$(slurp)" - | wl-copy && grim -g "$(slurp)" ~/Pictures/screenshots/screenshot_$(date +%Y%m%d_%H%M%S).png

# Reload sway config (Sway doesn't have "restart", only "reload")
bindsym $mod+Shift+r reload

# Exit sway
bindsym $mod+Shift+e exec swaynag -t warning -m 'You pressed the exit shortcut. Do you really want to exit sway? This will end your Wayland session.' -b 'Yes, exit sway' 'swaymsg exit'

# Network manager tray (needs --indicator for Wayland tray protocol)
exec nm-applet --indicator

# Notification daemon
exec mako

# Float browser notification popups that bypass mako
for_window [app_id="chrome-.*"] floating enable
for_window [title=".*— Indicator.*"] floating enable

# Per-output scaling. INTEGER scales only, on purpose: at a fractional scale (1.25)
# apps that don't implement wp-fractional-scale-v1 (Chrome, many others) render at an
# integer buffer scale and sway upscales them -> blurry on that output. Integer scales
# are crisp for every app. Conveniently the two land at nearly the same logical size:
# laptop eDP-1 236 DPI / 2 = 118, ultrawide HDMI-A-1 (ASUS VG34VQL3A) 110 DPI / 1 = 110.
# If you want the ultrawide bigger, prefer per-app font size over a fractional scale.
# Multi-monitor dock profiles (office/home/laptop) come via kanshi in step 2.
output eDP-1 scale 2
output HDMI-A-1 scale 1
output * bg ~/Pictures/DSC_0244.jpg fill

# Hidden Julia scratchpad calculator: wezterm --class sets the Wayland app_id (not an
# X11 class), so sway needs [app_id=...] here where i3 uses [class=...] in shared.
for_window [app_id="juliacalc"] move scratchpad, resize set 1200 600

# Lock screen: swaylock on demand + swayidle for auto-lock/DPMS (replaces xss-lock).
bindsym $mod+Shift+x exec swaylock -f -c 1c1b1a
exec swayidle -w \
    timeout 300 'swaylock -f -c 1c1b1a' \
    timeout 600 'swaymsg "output * power off"' \
    resume 'swaymsg "output * power on"' \
    before-sleep 'swaylock -f -c 1c1b1a'

# Workspace output assignments come with the kanshi dock profiles (step 2); until
# then sway auto-places workspaces on whatever outputs are connected.
