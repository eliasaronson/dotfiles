# kanshi — automatic per-profile output config on hotplug/dock (Wayland replacement
# for the X11 monitor-setup xrandr logic). kanshi applies the profile whose set of
# outputs exactly matches what's connected. Positions are in LOGICAL pixels (after
# scale). Scales are INTEGER on purpose (fractional blurs non-fractional-aware apps
# like Chrome; see wm/sway-only). Workspace->output assignment lives in wm/sway-only.
#
# TODO office: add a 3-monitor profile once docked there — run `swaymsg -t get_outputs`
# at the office for the real DP output names (they were DP-3/DP-4 under X11).

# Home: ultrawide (ASUS VG34VQL3A) left at native 1x, laptop to its right at 2x.
profile home {
    output HDMI-A-1 enable mode 3440x1440 scale 1 position 0,0
    output eDP-1 enable mode 3200x2000 scale 2 position 3440,0
}

# Laptop only. Slightly smaller than docked (2): you sit closer to the laptop when
# it's the only screen. 1.75 is fractional -> minor blur, but negligible at 236 DPI.
# Bump back to 2 if the blur bothers you.
profile laptop {
    output eDP-1 enable mode 3200x2000 scale 1.75 position 0,0
}
