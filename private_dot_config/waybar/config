{
  "layer": "top",
  "position": "bottom",
  "height": 26,
  "spacing": 6,
  "modules-left": ["sway/workspaces", "sway/mode"],
  "modules-center": ["custom/othertz", "clock"],
  "modules-right": ["mpris", "idle_inhibitor", "pulseaudio", "backlight", "network", "battery", "tray"],

  "custom/othertz": {
    "exec": "if [ \"$(timedatectl show -p Timezone --value)\" = \"Europe/Stockholm\" ]; then TZ='America/Los_Angeles' date '+%H:%M %Z'; else TZ='Europe/Stockholm' date '+%H:%M %Z'; fi",
    "interval": 30,
    "tooltip": false
  },

  "sway/workspaces": {
    "disable-scroll": false,
    "all-outputs": false,
    "strip-workspace-numbers": true
  },
  "sway/mode": {
    "format": " {}"
  },
  "clock": {
    "format": "{:%a %d %b  %H:%M}",
    "tooltip-format": "<tt><small>{calendar}</small></tt>",
    "calendar": {
      "mode": "month",
      "on-scroll": 1,
      "format": { "today": "<b>{}</b>" }
    }
  },
  "idle_inhibitor": {
    "format": "{icon}",
    "format-icons": { "activated": "", "deactivated": "" },
    "tooltip-format-activated": "Idle inhibited (won't auto-lock)",
    "tooltip-format-deactivated": "Idle allowed (auto-lock active)"
  },
  "mpris": {
    "format": "{player_icon} {title}",
    "format-paused": "{status_icon} {title}",
    "max-length": 40,
    "player-icons": { "default": "", "spotify": "", "chromium": "" },
    "status-icons": { "paused": "" }
  },
  "pulseaudio": {
    "format": "{icon} {volume}%",
    "format-muted": " muted",
    "format-icons": { "headphone": "", "default": ["", "", ""] },
    "on-click": "pactl set-sink-mute @DEFAULT_SINK@ toggle",
    "on-click-right": "pavucontrol",
    "on-scroll-up": "pactl set-sink-volume @DEFAULT_SINK@ +5%",
    "on-scroll-down": "pactl set-sink-volume @DEFAULT_SINK@ -5%"
  },
  "backlight": {
    "device": "intel_backlight",
    "format": "{icon} {percent}%",
    "format-icons": ["", "", "", "", ""],
    "on-scroll-up": "brightnessctl -d intel_backlight set +5%",
    "on-scroll-down": "brightnessctl -d intel_backlight set 5%-"
  },
  "network": {
    "format-wifi": " {signalStrength}%",
    "format-ethernet": " {ifname}",
    "format-disconnected": " off",
    "tooltip-format": "{essid}  {ipaddr}",
    "tooltip-format-ethernet": "{ifname}  {ipaddr}",
    "on-click": "nm-connection-editor"
  },
  "battery": {
    "bat": "BAT0",
    "adapter": "ADP0",
    "states": { "warning": 30, "critical": 15 },
    "format": "{icon} {capacity}%",
    "format-charging": " {capacity}%",
    "format-plugged": " {capacity}%",
    "format-icons": ["", "", "", "", ""],
    "tooltip-format": "{timeTo}  ({power}W)"
  },
  "tray": {
    "icon-size": 16,
    "spacing": 8
  }
}
