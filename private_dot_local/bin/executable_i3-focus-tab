#!/usr/bin/env python3
# Focus the Nth tab in the current i3 tabbed/stacked container. i3 has no native
# "focus tab N", so we walk the tree: find the focused node, climb to its nearest
# tabbed/stacked ancestor (the tab bar you're looking at), and focus that
# container's Nth child by con_id. Bound to $mod+Mod1+<number> in the i3 config.
import json
import subprocess
import sys


def focused_path(node, path):
    """Return the list of nodes from the tree root down to the focused node."""
    path = path + [node]
    if node.get("focused"):
        return path
    for child in node.get("nodes", []) + node.get("floating_nodes", []):
        found = focused_path(child, path)
        if found:
            return found
    return None


def main():
    if len(sys.argv) != 2 or not sys.argv[1].isdigit():
        return 0
    n = int(sys.argv[1])  # 1-based tab index
    if n < 1:
        return 0

    tree = json.loads(subprocess.check_output(["i3-msg", "-t", "get_tree"]))
    path = focused_path(tree, [])
    if not path:
        return 0

    # Nearest tabbed/stacked ancestor = the tab bar we're currently in.
    container = next(
        (node for node in reversed(path) if node.get("layout") in ("tabbed", "stacked")),
        None,
    )
    if container is None:
        return 0

    children = container.get("nodes", [])
    if 1 <= n <= len(children):
        con_id = children[n - 1]["id"]
        subprocess.run(["i3-msg", f"[con_id={con_id}] focus"], stdout=subprocess.DEVNULL)
    return 0


if __name__ == "__main__":
    sys.exit(main())
