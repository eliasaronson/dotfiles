#!/usr/bin/env bash
# Wayland/sway port of refresh-by-power: set the internal panel (eDP-1) refresh rate
# by power source + dock state.
#   laptop-only + AC -> 165 Hz (smooth)
#   docked (any external) OR on battery -> 60 Hz (saves scanout power on the 3200x2000
#   panel, frees PL4 headroom, avoids mixed-refresh jank on the external)
# kanshi owns scale/position/mode; this owns the eDP RATE and keeps it right across
# power-source and dock/undock changes. Run with --watch to stay resident.
set -u

OUTPUT=eDP-1
AC_RATE=165
BAT_RATE=60

# True while the lid is closed or logind is preparing/performing a sleep. Never
# modeset then: undock + unplug + lid-close fire a burst of udev events in the 1-3 s
# before suspend entry, and a full eDP modeset racing the suspend leaves sway with
# zero usable outputs after resume (black screen; 2026-09-18 incident).
suspending() {
    grep -q closed /proc/acpi/button/lid/*/state 2>/dev/null && return 0
    busctl get-property org.freedesktop.login1 /org/freedesktop/login1 \
        org.freedesktop.login1.Manager PreparingForSleep 2>/dev/null | grep -q true
}

apply() {
    command -v swaymsg >/dev/null 2>&1 || return 0
    suspending && return 0
    local status externals want cur
    status=$(cat /sys/class/power_supply/BAT0/status 2>/dev/null)
    externals=$(swaymsg -t get_outputs 2>/dev/null | python3 -c "
import sys, json
try: outs = json.load(sys.stdin)
except Exception: sys.exit(0)
print(sum(1 for o in outs if o.get('name') != '$OUTPUT' and o.get('active')))" 2>/dev/null)

    if [ "${externals:-0}" -ge 1 ]; then want=$BAT_RATE
    elif [ "$status" = "Discharging" ]; then want=$BAT_RATE
    else want=$AC_RATE; fi

    # Current eDP rate (Hz); empty if the panel is off (lid closed) -> skip.
    cur=$(swaymsg -t get_outputs 2>/dev/null | python3 -c "
import sys, json
try: outs = json.load(sys.stdin)
except Exception: sys.exit(0)
for o in outs:
    if o.get('name') == '$OUTPUT' and o.get('active'):
        print(round(o['current_mode']['refresh'] / 1000)); break" 2>/dev/null)
    [ -z "$cur" ] && return 0
    [ "$cur" = "$want" ] && return 0

    # Re-check right before the modeset: the lid may have closed while we were querying.
    suspending && return 0
    swaymsg output "$OUTPUT" mode "3200x2000@${want}Hz" >/dev/null 2>&1
}

apply

if [ "${1:-}" = "--watch" ]; then
    # One watcher only, even across sway reloads (exec_always re-runs this).
    exec 8>"/tmp/wl-refresh-by-power.watch.lock"
    flock -n 8 || exit 0
    # React to both power-source changes and dock/undock (drm). Debounce: wait 2 s, then
    # drain the rest of the udev burst and apply ONCE. BAT0/status lags a dock unplug
    # (still "Full" with zero externals), so acting on the first event would modeset to
    # 165 Hz and straight back to 60 -- right as a lid-close suspend begins.
    stdbuf -oL udevadm monitor --udev --subsystem-match=power_supply --subsystem-match=drm 2>/dev/null |
        while read -r _; do
            sleep 2
            while read -r -t 0.2 _; do :; done
            apply
        done
fi
