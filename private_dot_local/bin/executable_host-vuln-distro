#!/usr/bin/env python3
"""Second-pass CVE watchlist for a Nix closure, from DISTRO advisory feeds.

WHY THIS EXISTS
    host-vuln-scan matches the closure with grype, which on a Nix closure can only use
    its `nvd:cpe` source -- CPE string matching. Measured 2026-10-23, that is a small
    minority of what grype's own database holds: brotli has 1 nvd:cpe record out of 123,
    zstd has 0 out of 101. Everything else sits in DISTRO namespaces (debian:*, alpine:*,
    archlinux:*) keyed to deb/apk/pacman package identities a Nix closure does not have.
    The consequence was concrete: CVE-2026-111497 (critical, brotli 1.0.3-1.2.0) was in
    the local database under debian:* on the day it was published and never matched,
    while the closure carried brotli 1.2.0.

    This pass reads the same local database by PACKAGE NAME instead, so that data becomes
    reachable. Measured coverage: 278 of 1642 closure package names have advisory data in
    a rolling distro, against 15 packages the CPE pass has ever produced a finding for.

WHY ONLY ROLLING DISTROS
    A distro that BACKPORTS encodes the fix in its own revision, not the upstream version
    -- Red Hat records no usable constraint at all, and Debian stable says things like
    "7.88.1-10+deb12u5", which cannot be compared against a nixpkgs version. Rolling,
    minimally-patched distros fix by upgrading to upstream, so their threshold is an
    upstream version: alpine `< 7.36.0-r0`, arch `< 1.0.9-1`. Strip the trailing distro
    revision and the comparison is meaningful. Only those feeds are consulted.

READ THE OUTPUT AS A WATCHLIST, NOT AS FINDINGS
    nixpkgs sometimes backports a patch without bumping the version, so a patched
    nixpkgs 1.2.0 still trips an `< 1.2.1` threshold. Expect false positives of that
    shape. The useful half is often the "affected, no fix published" rows: that is what
    the brotli case looked like, and no version comparison would have produced it.

Usage:  host-vuln-distro SBOM.cdx.json [--exclude-cves "CVE-1 CVE-2 ..."]
"""
import argparse, json, os, re, sqlite3, subprocess, sys, tempfile, tomllib
from datetime import date
from collections import defaultdict

DB_DEFAULT = os.path.expanduser("~/.cache/grype/db/6/vulnerability.db")
# Distros that fix by moving to upstream. Named explicitly rather than selected by
# label_version alone: that label also catches feeds whose versioning is not upstream
# (echo's `v0.22.0+echo.1`), and a wrong comparison here is a silent false negative.
# Measured 2026-10-24, share of affected-package entries from CVE-2025 or later, and
# share of this closure's 1642 package names each feed carries:
#   minimos/rolling     97% fresh,  7% names     chainguard/wolfi family: very fresh but
#   chainguard/rolling  90% fresh,  7% names     a container/server catalog, so no avahi
#   wolfi/rolling       84% fresh,  7% names     or gdk-pixbuf
#   debian/unstable     40% fresh, 20% names     the workhorse: 27k entries from 2025+
#   alpine/edge         36% fresh, 13% names
# NOTE for image scanning: a Node/API image is almost entirely the chainguard catalog, so
# for CI the fresher feeds may beat debian -- the opposite of the right answer here.
#
# archlinux is DELIBERATELY EXCLUDED, despite being the most upstream-tracking distro --
# but NOT because grype's feed is stale. grype's `arch` provider is an accurate daily
# mirror; Arch itself barely publishes advisories now. Advisories by newest CVE year,
# grype's copy vs Arch's live tracker (2026-10-24): 3/3 for 2026, 42/42 for 2025, 18/18
# for 2023, 811/925 for 2021. The AVG counter stops at 2910 upstream too. That fits a
# rolling distro with no backporting -- there is little to track per CVE when the answer
# is "update" -- rather than neglect.
# It was also contributing nothing: Arch uses AVG-nnnn ids, which the CVE-id filter below
# discards, so all 2319 rows were dropped while `sources:` still advertised the feed.
# vulnerability_aliases maps AVG -> CVE (7739 rows) if revisited, but that unlocks only
# ~70 advisories for 2023-2026, all covered by debian.
ROLLING = {
    ("alpine", "edge"), ("wolfi", "rolling"),
    ("chainguard", "rolling"), ("minimos", "rolling"), ("debian", "unstable"),
}

# Only real CVE ids. Chainguard and Arch also emit their own aliases for the same bug
# (GHSA-xxxx, AVG-1742), which triple-counted every finding in the first run.
ID_OK = re.compile(r"^CVE-\d{4}-\d{4,}$")
# A threshold is only comparable if it is a plain upstream RELEASE. Arch carries git
# snapshots (`0.8+r127+g55d783d`) and Chainguard carries release candidates (`0.9_rc3`);
# both compare "newer" than every release and would flag the package forever.
UNUSABLE = re.compile(r"[_+~]|(?:^|[.\-])(?:rc|alpha|beta|dev|pre|snapshot|git)", re.I)

# A distro revision that indicates a patch applied to an UNCHANGED upstream version.
# apk -r0 and dpkg -1 are the FIRST packaging of a new upstream release, where the
# upstream number carries the fix and stripping is correct. -r1+, -2+ and the
# +debNuM style mean the upstream version did not move: the patch IS the fix, so
# stripping the revision destroys exactly the information we need.
APK_REV = re.compile(r"^(.*)-r(\d+)$")
DEB_REV = re.compile(r"^(.*?)-(\d+)(?:\.\d+)?(\+[A-Za-z0-9.~+]+)?$")

EPOCH = re.compile(r"^\d+:")
# apk `-r3`, pacman/dpkg `-1`, dpkg `-2+deb12u1`. Upstream versions do contain hyphens
# (`1.0-beta`), so only strip a trailing field that actually looks like a revision.
REV = re.compile(r"-(?:r\d+|\d+(?:[.+~][0-9A-Za-z.+~]*)?)$")


def revision_beyond_first(v):
    """True when only the revision moved, i.e. the fix is a patch on this upstream
    version. Measured 2026-10-24: 14% of alpine/edge and 13% of debian/unstable upper
    bounds are of this shape, and every one was previously invisible to this pass."""
    v = EPOCH.sub("", v.strip())
    m = APK_REV.match(v)
    if m:
        return int(m.group(2)) > 0
    m = DEB_REV.match(v)
    if m:
        return int(m.group(2)) > 1 or bool(m.group(3))
    return False


def upstream(v):
    """Reduce a distro version string to the upstream version it was built from."""
    v = EPOCH.sub("", v.strip())
    return REV.sub("", v)


def usable_threshold(v):
    """True if v is a plain upstream release we can meaningfully compare against."""
    return bool(v) and not UNUSABLE.search(v)


def verkey(v):
    """Sort key for DISPLAY ordering only -- the affected/not decision is made by
    builtins.compareVersions, never by this."""
    # Tag each component so numeric and alphabetic parts never compare against each
    # other: ("1.2.0" vs "1.2.0a") would otherwise raise TypeError.
    return [(0, int(x), "") if x.isdigit() else (1, 0, x) for x in re.split(r"[.\-]", v)]


def nix_compare(pairs):
    """builtins.compareVersions for every (a, b) pair, in ONE nix process.

    Deliberately not reimplemented in Python. Nix's component ordering has corners (the
    `pre` rule, empty-vs-numeric) and getting one wrong would drop findings silently --
    the exact failure mode this script exists to fix. Returns a list of -1/0/1.
    """
    if not pairs:
        return []
    esc = lambda s: s.replace("\\", "\\\\").replace('"', '\\"')
    expr = "builtins.map (p: builtins.compareVersions (builtins.head p) (builtins.elemAt p 1)) [\n"
    expr += "".join(f'  [ "{esc(a)}" "{esc(b)}" ]\n' for a, b in pairs) + "]\n"
    with tempfile.NamedTemporaryFile("w", suffix=".nix", delete=False) as fh:
        fh.write(expr)
        path = fh.name
    try:
        out = subprocess.run(["nix", "eval", "--file", path, "--json"],
                             capture_output=True, text=True, timeout=600)
        if out.returncode != 0:
            print(f"host-vuln-distro: nix eval failed: {out.stderr.strip()[:300]}", file=sys.stderr)
            return None
        return json.loads(out.stdout)
    finally:
        os.unlink(path)


def main():
    ap = argparse.ArgumentParser()
    ap.add_argument("sbom")
    ap.add_argument("--db", default=os.environ.get("GRYPE_DB", DB_DEFAULT))
    ap.add_argument("--exclude-cves", default="",
                    help="space-separated CVE ids already reported by the CPE pass")
    ap.add_argument("--suppress", metavar="TOML",
                    help="shared suppression file; [[ignore]] entries with "
                         "pass = \"both\" (default) or \"distro\" apply here. Without "
                         "this the distro pass has no way to silence a false positive.")
    ap.add_argument("--patched-map", metavar="JSON",
                    help="host-vuln-patches output. Findings whose CVE the package's own "
                         "nixpkgs derivation patches are dropped; nixpkgs fixes many CVEs "
                         "without a version bump and a distro threshold cannot see that.")
    ap.add_argument("--revfix-shared-threshold", type=int, default=3, metavar="N",
                    help="in the revision-level bucket, a CVE appearing on N or more "
                         "DIFFERENT packages is reported once as shared rather than per "
                         "package. Go toolchain CVEs behave this way -- chainguard rebuilds "
                         "every Go binary when Go is patched, so CVE-2026-56857 lands on "
                         "gitleaks, gh, docker-compose, tailscale and more at once, and "
                         "141 of 200 rows here came from seven Go packages. Default 3.")
    ap.add_argument("--unfixed-since-year", type=int, default=0,
                    help="only report affected-but-unfixed for CVEs of this year or later "
                         "(default: last year). Debian's unfixed set includes decades of "
                         "wontfix entries -- CVE-2004-0230 (the TCP RST attack) is still "
                         "'not-fixed' and always will be. Age is the only discriminator: "
                         "fix.state is 'not-fixed' for that and for brotli alike.")
    args = ap.parse_args()

    if not os.path.exists(args.db):
        print(f"host-vuln-distro: no grype DB at {args.db}; skipping distro pass", file=sys.stderr)
        return 2

    with open(args.sbom) as fh:
        sbom = json.load(fh)
    # One closure name can appear at several versions (lua 5.1.5 and 5.2.4 both present).
    installed = defaultdict(set)
    for comp in sbom.get("components", []):
        n, v = comp.get("name"), comp.get("version")
        if n and v:
            installed[n].add(v)
    if not installed:
        print("host-vuln-distro: SBOM had no name/version components", file=sys.stderr)
        return 2

    excluded = {c for c in args.exclude_cves.split() if c}
    # (cve, package, version) judgement calls from the shared suppression file.
    suppressed = set()
    if args.suppress:
        try:
            with open(args.suppress, "rb") as fh:
                for e in (tomllib.load(fh) or {}).get("ignore", []):
                    if e.get("pass", "both") in ("both", "distro") and e.get("id"):
                        suppressed.add((e["id"].upper(), e.get("package"),
                                        str(e["version"]) if e.get("version") else None))
        except (OSError, ValueError) as exc:
            print(f"host-vuln-distro: could not read {args.suppress}: {exc}", file=sys.stderr)

    # (pname, version) -> set of CVEs the derivation patches.
    patched = {}
    if args.patched_map:
        try:
            with open(args.patched_map) as fh:
                for pk in (json.load(fh) or {}).get("packages", []):
                    patched[(pk["pname"], pk["version"])] = {c.upper() for c in pk["cves"]}
        except (OSError, ValueError, KeyError) as exc:
            print(f"host-vuln-distro: could not read {args.patched_map}: {exc}", file=sys.stderr)
    cutoff_year = args.unfixed_since_year or (date.today().year - 1)
    con = sqlite3.connect(f"file:{args.db}?mode=ro", uri=True)

    # CVEs every provider marks rejected (withdrawn/disputed). 20k of them in this DB.
    rejected = {r[0] for r in con.execute(
        """SELECT name FROM vulnerability_handles GROUP BY name
           HAVING SUM(status = 'active') = 0 AND SUM(status = 'rejected') > 0""")}

    osids, osname = [], {}
    for oid, nm, lab in con.execute(
            "SELECT id, name, label_version FROM operating_systems WHERE label_version != ''"):
        if (nm, lab) in ROLLING:
            osids.append(oid)
            osname[oid] = f"{nm}/{lab}"
    if not osids:
        print("host-vuln-distro: no rolling distro feeds in this DB", file=sys.stderr)
        return 2

    names = list(installed)
    rows = []
    # Chunk the IN list: SQLite's default variable limit is ~32k but drivers vary.
    for i in range(0, len(names), 400):
        chunk = names[i:i + 400]
        q = f"""SELECT v.name, p.name, a.operating_system_id, b.value
                FROM affected_package_handles a
                JOIN packages p ON p.id = a.package_id
                JOIN vulnerability_handles v ON v.id = a.vulnerability_id
                JOIN blobs b ON b.id = a.blob_id
                WHERE p.name IN ({','.join('?' * len(chunk))})
                  AND a.operating_system_id IN ({','.join('?' * len(osids))})"""
        rows.extend(con.execute(q, chunk + osids))

    # Build candidates, collecting the version comparisons we need to resolve.
    unfixed, revfix, cmps, pending = {}, {}, [], []
    n_patched = n_suppressed = 0
    for cve, pkg, oid, blob in rows:
        cve = cve.upper()
        if cve in excluded or cve in rejected or not ID_OK.match(cve):
            continue
        try:
            ranges = (json.loads(blob) or {}).get("ranges") or []
        except (ValueError, AttributeError):
            continue
        constraints = [((r.get("version") or {}).get("constraint") or "").strip() for r in ranges]
        for inst in installed[pkg]:
            if cve in patched.get((pkg, inst), ()):
                n_patched += 1
                continue
            if ((cve, pkg, inst) in suppressed or (cve, pkg, None) in suppressed
                    or (cve, None, None) in suppressed):
                n_suppressed += 1
                continue
            if not any(constraints):
                # Listed as affected with no fixed version recorded. This is the brotli
                # shape, and the whole reason the pass is not gated on --only-fixed.
                # Age-gate only this bucket. A row WITH a fixed version is actionable
                # however old the CVE is; one without is only actionable while the fix is
                # still pending rather than declined years ago.
                if int(cve.split("-")[1]) >= cutoff_year:
                    unfixed[(cve, pkg, inst)] = osname[oid]
                continue
            for con_s in constraints:
                if not con_s:
                    continue
                lo = hi = hi_raw = None
                for part in con_s.split(","):
                    part = part.strip()
                    if part.startswith("<"):
                        hi_raw = part.lstrip("<=").strip()
                        hi = upstream(hi_raw)
                    elif part.startswith(">="):
                        lo = upstream(part[2:].strip())
                # The distro fixed this by patching the EXACT upstream version installed
                # here. Stripping the revision would make `installed < hi` false, so this
                # was silently dropped. It is a weaker signal than a version bump -- it
                # says "someone had to patch this release" -- so it gets its own bucket.
                if hi_raw and hi == inst and revision_beyond_first(hi_raw):
                    revfix[(cve, pkg, inst)] = (hi_raw, osname[oid])
                    continue
                if not usable_threshold(hi):
                    continue
                pending.append((cve, pkg, inst, osname[oid], lo, hi))
                cmps.append((inst, hi))
                if lo:
                    cmps.append((inst, lo))

    verdicts = nix_compare(cmps)
    if verdicts is None:
        return 3
    it = iter(verdicts)
    affected = {}
    for cve, pkg, inst, osn, lo, hi in pending:
        below_hi = next(it) < 0
        at_or_above_lo = next(it) >= 0 if lo else True
        if below_hi and at_or_above_lo:
            key = (cve, pkg, inst)
            # Several feeds may carry the same CVE; keep the lowest fixed version, the
            # earliest upstream release known to contain the fix. Ordering only, so the
            # local key is fine -- nix already decided affected-or-not above.
            prev = affected.get(key)
            if prev is None or verkey(hi) < verkey(prev[0]):
                affected[key] = (hi, {osn})
            elif hi == prev[0]:
                prev[1].add(osn)

    for key in affected:
        unfixed.pop(key, None)
        revfix.pop(key, None)
    for key in unfixed:
        revfix.pop(key, None)

    if not affected and not unfixed and not revfix:
        if n_patched:
            print(f"distro-feed watchlist: {n_patched} rows dropped as patched in nixpkgs")
        print("distro-feed watchlist: nothing new beyond the CPE pass")
        print("CVES_DISTRO")
        return 0

    print(f"distro-feed watchlist ({len(affected)} with a fixed version, "
          f"{len(unfixed)} affected-but-unfixed"
          + (f", {len(revfix)} patched-at-your-version" if revfix else "")
          + (f"; {n_patched} patched in nixpkgs" if n_patched else "")
          + (f"; {n_suppressed} suppressed" if n_suppressed else "") + ")")
    # Only feeds that actually contributed. Listing a configured-but-silent feed is how
    # archlinux looked like a source for a day while supplying nothing.
    contributing = sorted({src for _, srcs in affected.values() for src in srcs}
                          | set(unfixed.values()))
    quiet = sorted(set(osname.values()) - set(contributing))
    print("sources: " + (", ".join(contributing) or "none"))
    if quiet:
        print("  no rows from: " + ", ".join(quiet))
    print("NOTE: nixpkgs may carry a backported patch without a version bump -- verify "
          "before acting.")
    print()
    # One row per (package, installed, fixed-in). bind alone produced 28 separate CVE
    # rows against the same 9.20.30 in the first run; grouped, it is one actionable line.
    groups = defaultdict(lambda: (set(), set()))
    for (cve, pkg, inst), (hi, srcs) in affected.items():
        cves, who = groups[(pkg, inst, hi)]
        cves.add(cve)
        who.update(srcs)
    for (pkg, inst, hi) in sorted(groups, key=lambda k: (k[0], verkey(k[1]))):
        cves, who = groups[(pkg, inst, hi)]
        shown = sorted(cves)[:4]
        more = f" (+{len(cves) - len(shown)} more)" if len(cves) > len(shown) else ""
        print(f"  {pkg:<22} {inst:<14} -> {hi:<14} {len(cves):>3} CVE  [{', '.join(sorted(who))}]")
        print(f"      {', '.join(shown)}{more}")

    ungroups = defaultdict(lambda: (set(), set()))
    for (cve, pkg, inst), osn in unfixed.items():
        cves, who = ungroups[(pkg, inst)]
        cves.add(cve)
        who.add(osn)
    if ungroups:
        print()
        print(f"  AFFECTED, NO FIX PUBLISHED  (CVEs from {cutoff_year} on; "
              f"the shape the brotli miss had)")
        for (pkg, inst) in sorted(ungroups, key=lambda k: (k[0], verkey(k[1]))):
            cves, who = ungroups[(pkg, inst)]
            shown = sorted(cves)[:4]
            more = f" (+{len(cves) - len(shown)} more)" if len(cves) > len(shown) else ""
            print(f"  {pkg:<22} {inst:<14} {'':<17} {len(cves):>3} CVE  [{', '.join(sorted(who))}]")
            print(f"      {', '.join(shown)}{more}")

    if revfix:
        # Split out CVEs that recur across many packages. A package-specific flaw appears
        # on one package; a toolchain or vendored-dependency flaw lands on everything
        # built with it, and reporting it per package buries the rest.
        by_cve = defaultdict(set)
        for (cve, pkg, _inst) in revfix:
            by_cve[cve].add(pkg)
        shared = {c for c, pkgs in by_cve.items() if len(pkgs) >= args.revfix_shared_threshold}
        print()
        print("  PATCHED AT YOUR EXACT VERSION  (a distro shipped a patch without moving")
        print("  the upstream version, so this pass would otherwise miss it entirely.")
        print("  WEAKER SIGNAL: it means someone had to patch this release, not that")
        print("  nixpkgs has not -- the pedigree map has already removed what it claims.)")
        groups = defaultdict(lambda: (set(), set()))
        for (cve, pkg, inst), (raw, osn) in revfix.items():
            if cve in shared:
                continue
            cves, who = groups[(pkg, inst)]
            cves.add(cve)
            who.add(osn)
        for (pkg, inst) in sorted(groups, key=lambda k: (k[0], verkey(k[1]))):
            cves, who = groups[(pkg, inst)]
            shown = sorted(cves)[:4]
            more = f" (+{len(cves) - len(shown)} more)" if len(cves) > len(shown) else ""
            print(f"  {pkg:<22} {inst:<14} {'':<17} {len(cves):>3} CVE  [{', '.join(sorted(who))}]")
            print(f"      {', '.join(shown)}{more}")
        if shared:
            pkgs_hit = sorted({p for c in shared for p in by_cve[c]})
            print()
            print(f"  shared across {len(pkgs_hit)} packages ({len(shared)} CVEs) -- likely a "
                  f"toolchain or vendored dependency,")
            print(f"  not these packages' own code. Investigate the toolchain, not each binary:")
            print(f"      packages: {', '.join(pkgs_hit)}")
            print(f"      CVEs: {', '.join(sorted(shared)[:8])}"
                  + (f" (+{len(shared) - 8} more)" if len(shared) > 8 else ""))

    ids = sorted({k[0] for k in affected} | {k[0] for k in unfixed} | {k[0] for k in revfix})
    print()
    print("CVES_DISTRO " + " ".join(ids))
    return 0


if __name__ == "__main__":
    sys.exit(main())
