# Fly.io: the API token is TPM-sealed with systemd-creds at ~/.config/fly/token.cred
# instead of sitting in plaintext in ~/.fly/config.yml (which held an account-wide
# token reaching every production app). flyctl prefers FLY_ACCESS_TOKEN over the
# config file and never writes an env-supplied token back to disk: every write in
# internal/config/tokens.go is guarded on t.FromFile(), which only ParseFromFile
# sets. Decrypt goes through polkit (io.systemd.credentials.decrypt defaults to
# auth_admin_keep), so it prompts like sudo and then stays quiet for a few minutes.
# The org token expires 2027-01-21 and will NOT renew itself -- the discharge
# refresh is in-memory only for env-supplied tokens. Re-mint and re-seal with:
#   fly tokens create org -o andon-labs -x 2160h
#   systemd-creds encrypt --with-key=tpm2 --name=fly-token - ~/.config/fly/token.cred
# polkit's auth_admin_keep does NOT help here: it retains the grant against a
# unix-process subject, and every systemd-creds run is a new process, so the
# cached authorization never matches and you re-authenticate every single call
# (`pkcheck --list-temp` shows the dead husks). So cache in the shell instead,
# sudo-style. _fly_tok is a plain shell variable, not exported, so it is not in
# any child's /proc/<pid>/environ -- only in this shell's memory, and in flyctl's
# environment for the life of one command. Raise/lower FLY_TOKEN_TTL to taste.
: ${FLY_TOKEN_TTL:=900}
fly() {
  zmodload -F zsh/datetime p:EPOCHSECONDS 2>/dev/null
  if [[ -z $_fly_tok || $(( EPOCHSECONDS - ${_fly_tok_at:-0} )) -gt $FLY_TOKEN_TTL ]]; then
    _fly_tok=$(systemd-creds decrypt --name=fly-token ~/.config/fly/token.cred -) || return
    _fly_tok_at=$EPOCHSECONDS
  fi
  FLY_ACCESS_TOKEN=$_fly_tok command flyctl "$@"
}
flyctl() { fly "$@" }

# Modal: same TPM-sealed pattern as fly() above. Two values (id + secret) are sealed
# as two lines in one credential; MODAL_TOKEN_ID/_SECRET beat ~/.modal.toml in
# modal's config.py, so the plaintext ~/.modal.toml can go away entirely.
# Falls through to plain `modal` when the credential is absent, so this is safe to
# ship before the credential exists.
: ${MODAL_TOKEN_TTL:=900}
_modal_load() {
  zmodload -F zsh/datetime p:EPOCHSECONDS 2>/dev/null
  [[ -r ~/.config/modal/token.cred ]] || return 1
  if [[ -z $_modal_id || $(( EPOCHSECONDS - ${_modal_at:-0} )) -gt $MODAL_TOKEN_TTL ]]; then
    local out
    out=$(systemd-creds decrypt --name=modal-token ~/.config/modal/token.cred -) || return 1
    _modal_id=${out%%$'\n'*}
    _modal_secret=${out#*$'\n'}
    _modal_at=$EPOCHSECONDS
  fi
}
modal() {
  if _modal_load; then
    MODAL_TOKEN_ID=$_modal_id MODAL_TOKEN_SECRET=$_modal_secret command modal "$@"
  else
    command modal "$@"
  fi
}
# For `import modal` in Python: exports into THIS shell for the TTL window.
modal-env() {
  _modal_load || { print -u2 "modal-env: no sealed credential"; return 1 }
  export MODAL_TOKEN_ID=$_modal_id MODAL_TOKEN_SECRET=$_modal_secret
  print -u2 "modal-env: exported (TTL ${MODAL_TOKEN_TTL}s)"
}
