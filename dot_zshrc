# Shell-init snippets (zoxide/direnv/starship) are cached instead of `eval "$(tool
# init)"`, which forks a process per tool on EVERY shell start (~10ms each). The cache
# is regenerated automatically when the tool's binary is newer than it -- so a nixpkgs
# update (new store path) refreshes it by itself. Delete ~/.cache/zsh to force.
_zcache() {  # _zcache <name> <command> [args...]
  local f=${XDG_CACHE_HOME:-$HOME/.cache}/zsh/$1.zsh
  local bin=${commands[$2]}
  [[ -n $bin ]] || return
  if [[ ! -s $f || $bin -nt $f ]]; then
    mkdir -p ${f:h}
    "${@:2}" >| $f 2>/dev/null
  fi
  source $f
}
_zcache zoxide   zoxide init zsh
# direnv: auto-load per-project dev shells (.envrc -> `use flake`/`use nix`).
_zcache direnv   direnv hook zsh
# starship prompt — must come AFTER oh-my-zsh, which would otherwise set PROMPT.
# Config: ~/.config/starship.toml
